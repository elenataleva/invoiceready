# Both are optional in local development - the defaults below are what the
# code falls back to (src/api/client.ts, src/api/liveMode.ts).

# Where the JSON API lives. Only used in live mode; demo mode reads
# committed fixtures and never calls it.
VITE_API_BASE_URL=http://localhost:8000

# Forces demo mode on and makes the live toggle a no-op. Set in CI and any
# environment where a stray localStorage flag must not be able to start
# calling a real backend (and spending Anthropic credit).
VITE_DEMO_MODE=false
