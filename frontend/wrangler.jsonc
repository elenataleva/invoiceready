{
  // Cloudflare Workers static-assets config (the successor to Pages, which
  // is what the dashboard now creates by default). `npx wrangler deploy`
  // reads this; without it the deploy has no idea what to upload.
  //
  // There is no Worker script here on purpose - this is a pure static
  // bundle. docs/04-FRONTEND-DESIGN.md #8.1 picked Cloudflare for exactly
  // that: a static build with no SSR runtime to host.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "invoiceready",
  "compatibility_date": "2026-09-15",
  "assets": {
    "directory": "./dist",

    // React Router resolves /result and /how-it-works in the browser, so
    // nothing exists at those paths on disk. Without this, opening a shared
    // result link directly - or refreshing on one - 404s, which is the
    // classic way a client-side-routed app breaks only in production.
    //
    // This replaces the `/* /index.html 200` rule a Pages (or Netlify)
    // deploy would put in public/_redirects. Do not keep both: Workers
    // validates _redirects and rejects that rule as an infinite loop
    // (error 100324), which fails the deploy after the assets have already
    // uploaded. Moving to a host that wants _redirects means adding that
    // file back and dropping this key.
    "not_found_handling": "single-page-application"
  }
}
