# openapi-typescript 7.13 still declares `peer typescript@^5.x`, but this
# project is on TypeScript 6 (chosen by the Vite scaffold). The conflict is
# a stale peer range on a dev-only codegen tool, not a real incompatibility
# - `npm run gen:api` works and its output typechecks.
#
# Committed rather than passed per-command so every install resolves the
# same way: `npm install` locally, `npm ci` in CI, and anyone cloning this.
# Revisit when openapi-typescript widens the range.
legacy-peer-deps=true
